# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Cloud Run / Preview service URL injected automatically by AI Studio.
APP_URL="MY_APP_URL"

# VITE_SITE_URL: Canonical production domain used for <link rel="canonical">, og:url, robots.txt and sitemap.xml.
VITE_SITE_URL="https://globallove.vercel.app"

# VITE_BING_VERIFICATION: Optional Bing Webmaster msvalidate.01 verification token.
VITE_BING_VERIFICATION=""
